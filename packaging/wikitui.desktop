# wikitui .desktop entry — packaging groundwork only.
#
# This file is NOT installed by `cargo install` or `cargo build`; it exists
# in-repo for distro packagers (nixpkgs/AUR/Debian/Fedora — PRD §8) to copy
# into their package's data files if they choose to.
#
# The MimeType line below declares wikitui as a handler for `wiki://` URIs
# per PRD FR-CS-7 ("Protocol handler: wiki:// x-scheme-handler via .desktop
# on Linux"). FR-CS-7 is a v2/P2, best-effort roadmap item (see PRD.md §12,
# the "Scholar" milestone) — wikitui does NOT parse, register, or handle
# `wiki://` URIs today. Installing this file alone does not make the
# protocol handler work; it only tells desktop environments where to route
# such URIs once (and if) that support ships. Treat this as a placeholder
# a packager can wire up later, not a working feature.
[Desktop Entry]
Type=Application
Name=wikitui
GenericName=Wikipedia Reader
Comment=An unofficial, keyboard-first terminal client for Wikipedia (not endorsed by the Wikimedia Foundation)
Exec=wikitui %u
Terminal=true
Categories=Network;Utility;
MimeType=x-scheme-handler/wiki;
NoDisplay=false
